# jre-vidget environment configuration example
# Copy to .env and fill in values (this file is safe to commit)

# Optional: override default download directory
# VIDGET_DOWNLOAD_DIR=~/Downloads/vidget

# Optional: yt-dlp cookies file path (for age-restricted content)
# VIDGET_COOKIES_FILE=~/.config/vidget/cookies.txt

# Optional: Python logging level for the vidget CLI process (default WARNING).
# Accepted names match the logging module: DEBUG, INFO, WARNING, ERROR, CRITICAL, NOTSET.
# Invalid values fall back to WARNING.
# VIDGET_LOG_LEVEL=INFO

# Optional: set to ``json`` for one JSON object per line on stderr (stdlib logging only).
# VIDGET_LOG_FORMAT=json
