# jre-vidget environment configuration example
# Copy to .env and fill in values (this file is safe to commit)

# Optional: override default download directory
# VIDGET_DOWNLOAD_DIR=~/Downloads/vidget

# Optional: yt-dlp cookies file path (for age-restricted content)
# VIDGET_COOKIES_FILE=~/.config/vidget/cookies.txt

# Optional: Python logging level for the vidget CLI process (default WARNING).
# Accepted names match the logging module: DEBUG, INFO, WARNING, ERROR, CRITICAL, NOTSET.
# Invalid values fall back to WARNING.
# VIDGET_LOG_LEVEL=INFO

# Optional: set to ``json`` for one JSON object per line on stderr (stdlib logging only).
# Other CLI messages (e.g. publish errors with ``--json``) may still be plain text on stderr.
# VIDGET_LOG_FORMAT=json

# Optional: Google / YouTube OAuth overrides (CLI and CI). Prefer GitHub Actions secrets on forks.
# See docs/SETUP.md — primary client id is GCLOUD_CLIENT_ID; GCLOUD_AUTH_CLIENT_ID is optional.
# GCLOUD_CLIENT_ID=
# GCLOUD_AUTH_CLIENT_ID=
# GCLOUD_CLIENT_SECRET=
# GCLOUD_REFRESH_TOKEN=
# Legacy aliases still supported: VIDGET_CLIENT_ID, VIDGET_CLIENT_SECRET, VIDGET_REFRESH_TOKEN

# Optional: localhost port for ``vidget auth login`` OAuth callback (default 8080; must be 1–65535).
# Invalid values log a warning and fall back to 8080. If consent fails, add the matching
# redirect URI in Google Cloud Console — see docs/SETUP.md (Custom OAuth callback port).
# VIDGET_OAUTH_PORT=8080
