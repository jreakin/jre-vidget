#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# bin/vidget — Docker wrapper for jre-vidget
#
# Drop this script (or symlink it) somewhere on your PATH, then use `vidget`
# exactly as you would the native CLI. Downloaded files land in ~/Downloads
# by default, or set VIDGET_OUTPUT to override.
#
# Usage:
#   vidget download "https://..." [--output /path/to/dir]
#   vidget batch urls.txt [--output /path/to/dir]
#   vidget formats "https://..." --json
#   vidget --help
#
# First-time setup (from the repo root):
#   docker build -t jre-vidget .
#
# Use in another project's Makefile:
#   include /path/to/jre-vidget/bin/vidget.mk
# ---------------------------------------------------------------------------
set -euo pipefail

IMAGE="${VIDGET_IMAGE:-jre-vidget}"
OUTPUT_DIR="${VIDGET_OUTPUT:-$HOME/Downloads}"

# Build the image if it doesn't exist yet
if ! docker image inspect "$IMAGE" &>/dev/null; then
  echo "jre-vidget: image '$IMAGE' not found — building..." >&2
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  docker build -t "$IMAGE" "$SCRIPT_DIR/.."
fi

exec docker run --rm \
  -v "${OUTPUT_DIR}:/downloads" \
  -e VIDGET_OUTPUT_DIR=/downloads \
  "$IMAGE" "$@"
