#!/usr/bin/env bash
# .githooks/commit-msg
# Enforces conventional commit format on every commit message.
# Installed via: git config core.hooksPath .githooks  (or: make setup-hooks)

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -1 "$COMMIT_MSG_FILE")

# Pass through merge commits, revert auto-messages, fixup/squash commits
if echo "$FIRST_LINE" | grep -qE "^(Merge|Revert|fixup!|squash!) "; then
  exit 0
fi

# Pass through WIP commits (local only — CI title check blocks these on PRs)
if echo "$FIRST_LINE" | grep -qiE "^wip[: ]"; then
  exit 0
fi

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?(!)?: .+"

if echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  exit 0
fi

echo ""
echo "❌  Commit rejected: message does not follow conventional commit format."
echo ""
echo "   Got:      $FIRST_LINE"
echo "   Expected: <type>(<scope>): <description>"
echo ""
echo "   Valid types:"
echo "     feat      — new feature        → bumps minor version"
echo "     fix       — bug fix            → bumps patch version"
echo "     perf      — performance gain   → bumps patch version"
echo "     docs      — documentation only"
echo "     refactor  — no feature or fix"
echo "     test      — tests only"
echo "     build     — deps / build system"
echo "     ci        — CI/CD changes"
echo "     chore     — maintenance"
echo "     revert    — reverts a commit"
echo ""
echo "   Breaking change — append ! before the colon:"
echo "     feat!: drop Python 3.10 support"
echo ""
echo "   With scope:"
echo "     fix(engine): handle None return from yt-dlp"
echo "     feat(cli): add --json flag to preview command"
echo ""
echo "   To skip this check (local only, not recommended):"
echo "     git commit --no-verify"
echo ""
exit 1
